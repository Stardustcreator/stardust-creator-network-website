{
  "name": "stardust-creator-network-website",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build && next-sitemap && npm run critical-css",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "sitemap": "next-sitemap",
    "clean": "rimraf .next out dist",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:bundles": "cross-env ANALYZE=true npm run build",
    "check:unused-deps": "depcheck --ignores='@types/*,eslint-*,prettier,@axe-core/*,playwright,vitest,husky,lint-staged,rimraf,cross-env,dotenv-cli'",
    "check:unused-imports": "unimport --check",
    "analyze:unused": "node scripts/analyze-unused.js",
    "optimize": "npm run check:unused-deps && npm run build && npm run critical-css && npm run performance-audit",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run test && NODE_OPTIONS=--max-old-space-size=4096 npm run build",
    "studio:deploy": "dotenv -e .env.local -- sanity deploy",
    "critical-css": "node scripts/critical-css.js",
    "performance-audit": "lighthouse https://stardustcreators.com --output=json --output-path=./performance-report.json",
    "performance-optimize": "npm run clean && npm run critical-css && npm run build && npm run performance-audit"
  },
  "dependencies": {
    "@portabletext/react": "^3.0.16",
    "@portabletext/types": "^2.0.7",
    "@sanity/icons": "^2.1.0",
    "@sanity/image-url": "^1.0.2",
    "@sanity/vision": "^3.23.4",
    "@sentry/nextjs": "^7.100.1",
    "@supabase/supabase-js": "^2.42.0",
    "@vercel/analytics": "^1.2.2",
    "@vercel/og": "^0.6.2",
    "clsx": "^2.1.0",
    "googleapis": "^129.0.0",
    "next": "16.0.7",
    "next-sanity": "^7.1.0",
    "next-sitemap": "^4.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sanity": "^3.33.0",
    "styled-components": "^6.1.1",
    "tailwind-merge": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@next/bundle-analyzer": "^16.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.2",
    "lint-staged": "^16.2.6",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unimport": "^5.5.0",
    "vitest": "^4.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.17.0 <21.0.0",
    "npm": ">=8.0.0"
  }
}
